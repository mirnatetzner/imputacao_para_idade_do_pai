RTFT_reigi
# Juntar as tabelas
tft_merged_regi <- left_join(tftm_tabela_larga, tftf_todos, by = "UF") %>%
mutate(
TFTM = as.numeric(gsub(",", ".", TFTM)),
TFTF = as.numeric(gsub(",", ".", TFTF))
) %>%
filter((UF %in% c("BR","NO", "ND", "SU", "SD", "CO"))) %>%
# Criar uma coluna indicando se é BR ou não
mutate(destaque = ifelse(UF == "BR", "Brasil", "Outras UFs"))
# Plotar
RTFT_reigi = ggplot(tft_merged_regi, aes(x = TFTM, y = TFTF, label = UF)) +
# Pontos com cor condicional
geom_point(aes(color = destaque, size = destaque)) +
scale_color_manual(values = c("Brasil" = "blue", "Outras UFs" = "red")) +
scale_size_manual(values = c("Brasil" = 3, "Outras UFs" = 1.5)) +
# Texto também com cor condicional (opcional)
geom_text(aes(color = destaque), vjust = -0.8, size = 3.5, show.legend = FALSE) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray40") +
labs(
x = "Taxa de Fecundidade Total Masculina (TFTM)",
y = "Taxa de Fecundidade Total Feminina (TFTF)"
) +
theme_minimal() +
theme(
axis.title = element_text(size = 14),
axis.text = element_text(size = 12)
) +
# Opcional: remover legenda do tamanho (se preferir)
guides(color = guide_legend(title = "UF"), size = "none")
# Exibir o gráfico
print(RTFT_reigi)
RTFT_reigi
