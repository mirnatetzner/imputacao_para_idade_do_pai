# Filtrar valores válidos
fluxo_validado <- fluxo_um %>%
mutate(
IDADEMAE = as.numeric(IDADEMAE),
IDADEPAI = as.numeric(IDADEPAI)
)
# Calcular por REGIÃO
idade_media_regiao <- fluxo_validado %>%
filter(!is.na(IDADEMAE), IDADEMAE >= 15, IDADEMAE <= 50,
!is.na(IDADEPAI), IDADEPAI >= 15, IDADEPAI <= 60) %>%
group_by(REGIAO) %>%
summarise(
idade_media_mae = mean(IDADEMAE, na.rm = TRUE),
idade_media_pai = mean(IDADEPAI, na.rm = TRUE),
.groups = "drop"
)
# Calcular para o BRASIL
idade_media_brasil <- fluxo_validado %>%
filter(!is.na(IDADEMAE), IDADEMAE >= 15, IDADEMAE <= 50,
!is.na(IDADEPAI), IDADEPAI >= 15, IDADEPAI <= 60) %>%
summarise(
REGIAO = "BRASIL",
idade_media_mae = mean(IDADEMAE, na.rm = TRUE),
idade_media_pai = mean(IDADEPAI, na.rm = TRUE)
)
# Juntar os resultados
idade_media_total <- bind_rows(idade_media_regiao, idade_media_brasil)
idade_media_total
