geom_point(aes(color = destaque, size = destaque)) +
scale_color_manual(values = c("Brazil" = "#2166AC", "Regions" = "#B2182B")) +
scale_size_manual(values = c("Brazil" = 1.5, "Regions" = 1.5)) +
# Texto também com cor condicional (opcional)
geom_text(aes(color = destaque), vjust = -0.8, size = 3.5, show.legend = FALSE) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray40") +
labs(
x = "Male total fetility rate",
y = "Female total fetility rate"
) +
theme_minimal() +
theme(
axis.title = element_text(size = 14),
axis.text = element_text(size = 12)
) +
# Opcional: remover legenda do tamanho (se preferir)
guides(color = guide_legend(title = "Legend"), size = "none")
ggsave(paste0(path, "RTFT_reioes.png"), RTFT_reigi, width = 7, height = 5, dpi = 300)
save.image("~/Documentos/Dissetacao/imputacao_para_idade_do_pai/codigos/20260615_resultados_tds.RData")
